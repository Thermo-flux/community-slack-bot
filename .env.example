# Slack Credentials
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Optional per-channel overrides; blank uses the IDs in config/config.json.
# Each ID is verified against its exact public Slack channel name at startup.
OFFICIAL_LOADOUT_CHANNEL_ID=
LOADOUT_DEVELOPMENT_CHANNEL_ID=

# Optional Slack user IDs: the owner confirms all-time results; Orry is the
# program authority Goose can @mention when it hands off a hard LOADOUT question.
OWNER_USER_ID=
ORRY_USER_ID=

# Optional explicit channel override (comma-separated channel IDs).
# When set, exactly these channels are watched (public or private, each
# verified at startup), replacing the named channel pair above. Blank uses the pair.
WATCHED_CHANNELS=C0C68G3K0AJ

# AI Configuration (gemini | openai | openrouter | custom | anthropic | mock)
AI_PROVIDER=custom
AI_API_KEY=your-ai-api-key-here
AI_MODEL=anthropic/claude-haiku-5.5
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_REASONING_EFFORT=low
# Configurable connect/read timeout and response-body deadline. The bot does not retry slow requests.
AI_TIMEOUT_SECONDS=15
# Keep answers concise and bound concurrent AI work.
AI_MAX_REPLY_CHARS=400
AI_MAX_OUTPUT_TOKENS=512
AI_REPLY_WORKERS=4
AI_REPLY_QUEUE_SIZE=12

# SQLite Database Location
DB_PATH=data/community_karma.db
