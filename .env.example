# Gateway secrets. Copy to .env and fill in. Never commit .env.
# Slack bot token (xoxb-...) from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
# Slack app-level token (xapp-..., scope connections:write) for Socket Mode
SLACK_APP_TOKEN=xapp-REPLACE-ME
# Shared secret with the voice service. Must equal VOICE_SHARED_SECRET in voice.env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VOICE_SHARED_SECRET=REPLACE-WITH-A-LONG-RANDOM-VALUE
