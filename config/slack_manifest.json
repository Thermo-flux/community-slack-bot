{
  "display_information": {
    "name": "Goose Lee",
    "description": "Tracks contributions and answers when called.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "Goose Lee",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/level",
        "description": "View your current level, points (XP), and progress bar",
        "usage_hint": "[optional]",
        "should_escape": false
      },
      {
        "command": "/rank",
        "description": "View your contributor rank and XP card",
        "usage_hint": "[optional]",
        "should_escape": false
      },
      {
        "command": "/card",
        "description": "View a contributor card",
        "usage_hint": "[optional] username",
        "should_escape": false
      },
      {
        "command": "/leaderboard",
        "description": "Show the top community contributors and rankings",
        "usage_hint": "[optional]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:read",
        "channels:history",
        "im:history",
        "chat:write",
        "commands",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
