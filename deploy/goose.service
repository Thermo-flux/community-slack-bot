# systemd unit for the gateway (bare-metal alternative to Docker). Install steps: docs/RUNBOOK.md.
[Unit]
Description=goose-lee Slack duck (gateway)
Documentation=file:///opt/goose-lee/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# Stop restarting after 5 failures in 5 minutes (a bad token or config would loop forever otherwise)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=goose
Group=goose
WorkingDirectory=/opt/goose-lee
# Secrets live in this file only: root:goose, mode 0640. Never in the unit or the repo.
EnvironmentFile=/etc/goose-lee/goose.env
ExecStart=/opt/goose-lee/.venv/bin/python -m goose.gateway.app --config /opt/goose-lee/config/goose.yaml
Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
# The only writable place: the database, the audit log and backups
ReadWritePaths=/opt/goose-lee/data /opt/goose-lee/backups

[Install]
WantedBy=multi-user.target
