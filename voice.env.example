# Voice service secrets and settings. Copy to voice.env and fill in. Never commit voice.env.
# Must equal VOICE_SHARED_SECRET in .env (the gateway).
VOICE_SHARED_SECRET=REPLACE-WITH-THE-SAME-VALUE-AS-ENV
# Port inside the voice container (no port is published to the host)
VOICE_PORT=8081
# LLM provider wire format: openai (OpenAI and most other providers) or anthropic (Anthropic Messages API)
LLM_API_FORMAT=openai
# Prompt caching: on (default) or off. Cuts billed input cost for the stable prompt; never changes replies.
LLM_CACHE=on
# LLM provider base URL for the chosen format (see docs/RUNBOOK.md)
LLM_BASE_URL=https://REPLACE-PROVIDER-HOST/v1
# Key for the provider. Goes in the Authorization header only. Set a spending limit in the provider console.
LLM_API_KEY=REPLACE-ME
# Model id. Must appear in LLM_MODEL_ALLOWLIST or the voice refuses to start.
LLM_MODEL=REPLACE-MODEL-ID
# Comma-separated list of approved model ids
LLM_MODEL_ALLOWLIST=REPLACE-MODEL-ID
# Provider request deadline in seconds. Default is 20; keep below gateway voice.timeout_s (30 by default).
LLM_TIMEOUT_S=20
# Known OpenAI-compatible Grok ids grok-4.5, grok-4.6, grok-4.7 and x-ai/ forms default to low effort.
# Set this to override low for Grok, or to request effort for another supported OpenAI-compatible model.
# LLM_REASONING_EFFORT=medium
# Internal reasoning completion headroom, separate from the visible 350/600-token reply budgets. Default 4096.
# Applies to OpenAI-compatible reasoning requests. Other providers keep their existing behavior.
# LLM_REASONING_MAX_TOKENS=4096
