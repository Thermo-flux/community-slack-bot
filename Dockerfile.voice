# Voice image: one HTTP endpoint and the LLM client. Standard library only, so nothing is installed here.
# It copies only goose/__init__.py and goose/voice/. It has no Slack code, no database code and no core.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system voice \
    && useradd --system --gid voice --home-dir /app --shell /usr/sbin/nologin voice

WORKDIR /app

COPY goose/__init__.py goose/__init__.py
COPY goose/voice/ goose/voice/

USER voice

EXPOSE 8081

HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('VOICE_PORT', '8081'), timeout=5)"]

CMD ["python", "-m", "goose.voice.server"]
