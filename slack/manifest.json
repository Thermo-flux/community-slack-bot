{
  "display_information": {
    "name": "goose-lee",
    "description": "A community duck for the pond. Says hi, keeps score, and never plays favourites.",
    "background_color": "#2b5d3a"
  },
  "features": {
    "bot_user": {
      "display_name": "goose-lee",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/goose",
        "description": "Talk to goose-lee",
        "usage_hint": "help | join | leave | show | hide | rest | quiet on|off | me | top | all | explain | pun | quack | report | appeal",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "app_mentions:read",
        "channels:history",
        "reactions:read",
        "reactions:write",
        "users:read",
        "files:write",
        "channels:read",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "app_mention",
        "reaction_added",
        "reaction_removed",
        "member_joined_channel"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
